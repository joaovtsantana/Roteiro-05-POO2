using System;

using System;
using Xunit;

namespace AulaTestes
{
    public class CalculadoraIMCTests
    {
        [Fact]
        public void Calcular_70_175_DeveRetornar22_86()
        {
            var calculadora = new CalculadoraIMC();

            Assert.Equal(22.86, calculadora.Calcular(70, 1.75), 2);
        }

        [Fact]
        public void Classificar_17_DeveRetornarAbaixoDoPeso()
        {
            var calculadora = new CalculadoraIMC();

            Assert.Equal("Abaixo do peso", calculadora.Classificar(17));
        }

        [Fact]
        public void Classificar_26_DeveRetornarSobrepeso()
        {
            var calculadora = new CalculadoraIMC();

            Assert.Equal("Sobrepeso", calculadora.Classificar(26));
        }

        [Fact]
        public void Calcular_AlturaZero_DeveLancarExcecao()
        {
            var calculadora = new CalculadoraIMC();

            Assert.Throws<ArgumentException>(() => calculadora.Calcular(70, 0));
        }
    }
}


namespace AulaTestes
{
    public class CalculadoraIMC
    {
        public double Calcular(double peso, double altura)
        {
            if (altura <= 0)
                throw new ArgumentException("Altura deve ser maior que zero");

            return peso / (altura * altura);
        }

        public string Classificar(double imc)
        {
            if (imc < 18.5) return "Abaixo do peso";
            if (imc < 25) return "Peso normal";
            if (imc < 30) return "Sobrepeso";
            return "Obesidade";
        }
    }
}

