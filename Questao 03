using Xunit;

namespace AulaTestes
{
    public class ConversorTemperatura
    {
        public double CelsiusParaFahrenheit(double c)
        {
            return (c * 9 / 5) + 32;
        }
        public double FahrenheitParaCelsius(double f)
        {
            return (f - 32) * 5 / 9;
        }
    }


    namespace AulaTestes
    {
        public class ConversorTemperaturaTests
        {
            [Fact]
            public void CelsiusParaFahrenheit_Zero_DeveRetornar32()
            {
                var conversor = new ConversorTemperatura();

                Assert.Equal(32, conversor.CelsiusParaFahrenheit(0), 2);
            }

            [Fact]
            public void CelsiusParaFahrenheit_Cem_DeveRetornar212()
            {
                var conversor = new ConversorTemperatura();

                Assert.Equal(212, conversor.CelsiusParaFahrenheit(100), 2);
            }

            [Fact]
            public void FahrenheitParaCelsius_32_DeveRetornarZero()
            {
                var conversor = new ConversorTemperatura();

                Assert.Equal(0, conversor.FahrenheitParaCelsius(32), 2);
            }

            [Fact]
            public void FahrenheitParaCelsius_212_DeveRetornar100()
            {
                var conversor = new ConversorTemperatura();

                Assert.Equal(100, conversor.FahrenheitParaCelsius(212), 2);
            }
        }
    }
}
